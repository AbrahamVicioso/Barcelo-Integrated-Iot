# ═══════════════════════════════════════════════════════════════════════
# BARCELO IOT - Configuración de entorno
# Copia este archivo como .env y ajústalo según tu entorno
# ═══════════════════════════════════════════════════════════════════════

# ── Entorno ─────────────────────────────────────────────────────────────
# development: Certificados autofirmados locales (scripts/generate-dev-certs.ps1)
# production: Certificados de Let's Encrypt (Certbot)
ENVIRONMENT=development
DOMINIO_PRINCIPAL=smartstay.es
CERT_DOMAIN=smartstay.es

# ── NuGet Cache (opcional, acelera builds) ─────────────────────────
# Windows (desde WSL2):
# NUGET_PACKAGES=/mnt/c/Users/TU_USUARIO/.nuget/packages
#
# Linux / Mac:
# NUGET_PACKAGES=/home/TU_USUARIO/.nuget/packages
NUGET_PACKAGES=/mnt/c/Users/abrah/.nuget/packages

# ── Azure Communication Services ─────────────────────────────────────────────
AZURE_COMMUNICATION_CONNECTION_STRING=
AZURE_COMMUNICATION_SENDER_ADDRESS=

# ── ntfy Push Notifications ───────────────────────────────────────────────────
# DEVELOPMENT (NTFY_COMMAND=serve-http):
#   - Solo HTTP en puerto 8082 (el 443 queda libre)
#   - No requiere certificados SSL
#   - healthcheck usa HTTP
#   - Ejecuta: docker compose up -d ntfy
#   - AccessToken vacío funciona
#
# PRODUCTION (NTFY_COMMAND=serve):
#   - HTTPS en puerto 8081, HTTP en 8082
#   - Requiere certificados en docker/certs/live/smartstay.es/
#   - Configura NTFY_ADMIN_PASSWORD y NTFY_SERVER_TOKEN
#
# Para desarrollo local:
#   1. docker compose up -d ntfy (primera vez)
#   2. docker exec -it barcelo-ntfy ntfy user add --role=admin admin
#   3. docker exec barcelo-ntfy ntfy token add admin
#   4. Copia los tokens a NTFY_ADMIN_PASSWORD y NTFY_SERVER_TOKEN
#   5. docker compose up -d
NTFY_COMMAND=serve-http
NTFY_HEALTHCHECK=wget -q --tries=1 http://localhost:80/v1/health -O - | grep -c healthy || exit 1

# Desarrollo: no requiere tokens ni certificados
NTFY_ADMIN_PASSWORD=
NTFY_SERVER_TOKEN=
NTFY_AUTH_DEFAULT_ACCESS=read-write

# Producción: descomenta y configura tus tokens
# NTFY_ADMIN_PASSWORD=tu_password_admin
# NTFY_SERVER_TOKEN=tu_token_aqui
# NTFY_AUTH_DEFAULT_ACCESS=deny-all

# ── URLs Públicas (para producción con dominio real) ────────────────────────────────
GATEWAY_PUBLIC_BASE_URL=https://smartstay.es:5020
NTFY_PUBLIC_BASE_URL=https://smartstay.es:8081
