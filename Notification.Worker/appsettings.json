{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Ntfy": {
    "BaseUrl": "https://localhost:8081",
    "TopicPrefix": "barcelo"
  },
  "AuthApi": {
    "BaseUrl": "http://localhost:5117"
  },
  "KafkaConsumer": {
    "UserCreated": {
      "BootstrapServers": "localhost:9092",
      "GroupId": "notification-user-created-group",
      "Topic": "users",
      "AutoOffsetReset": "Earliest",
      "EnableAutoCommit": true,
      "AutoCommitIntervalMs": 5000,
      "SessionTimeoutMs": 30000,
      "MaxPollIntervalMs": 300000
    },
    "ReservaCreada": {
      "BootstrapServers": "localhost:9092",
      "GroupId": "notification-reserva-creada-group",
      "Topic": "reservas",
      "AutoOffsetReset": "Earliest",
      "EnableAutoCommit": true,
      "AutoCommitIntervalMs": 5000,
      "SessionTimeoutMs": 30000,
      "MaxPollIntervalMs": 300000
    },
    "EmailConfirmation": {
      "BootstrapServers": "localhost:9092",
      "GroupId": "notification-email-confirmation-group",
      "Topic": "email-confirmation",
      "AutoOffsetReset": "Earliest",
      "EnableAutoCommit": true,
      "AutoCommitIntervalMs": 5000,
      "SessionTimeoutMs": 30000,
      "MaxPollIntervalMs": 300000
    }
  }
}
