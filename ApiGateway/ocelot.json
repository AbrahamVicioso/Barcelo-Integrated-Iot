        "GET"
      ]
    },
    // Route for Audit Service
    {
      "DownstreamPathTemplate": "/audit",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5250
        }
      ],
