# Copia este archivo como .env y ajusta la ruta a tu caché de NuGet local.
# Esto evita que los contenedores necesiten descargar paquetes de internet.
#
# Windows (desde WSL2):
# NUGET_PACKAGES=/mnt/c/Users/TU_USUARIO/.nuget/packages
#
# Linux / Mac:
# NUGET_PACKAGES=/home/TU_USUARIO/.nuget/packages
NUGET_PACKAGES=/mnt/c/Users/abrah/.nuget/packages

# ── Azure Communication Services ─────────────────────────────────────────────
AZURE_COMMUNICATION_CONNECTION_STRING=
AZURE_COMMUNICATION_SENDER_ADDRESS=

# ── ntfy Push Notifications ───────────────────────────────────────────────────
# DEV: deja estas variables vacías → ntfy arranca en modo read-write (abierto).
# PROD: sigue estos pasos para hardenizar:
#
#   1. Levanta solo ntfy primero:
#      docker compose up -d ntfy
#
#   2. Crea el usuario admin (introduce la contraseña que quieras):
#      docker exec -it barcelo-ntfy ntfy user add --role=admin admin
#
#   3. Copia esa contraseña aquí:
#      NTFY_ADMIN_PASSWORD=mi-password-admin
#
#   4. Genera un token para el servidor (el worker lo usa para publicar):
#      docker exec barcelo-ntfy ntfy token add admin
#      Copia el token (empieza con tk_...)
#      NTFY_SERVER_TOKEN=tk_xxxxxxxxxxxxx
#
#   5. Activa deny-all:
#      NTFY_AUTH_DEFAULT_ACCESS=deny-all
#
#   6. Levanta el resto: docker compose up -d
NTFY_ADMIN_PASSWORD=
NTFY_SERVER_TOKEN=
NTFY_AUTH_DEFAULT_ACCESS=
